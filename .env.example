# ---- Database (Hendy) ----  Local: Postgres; production: Neon (pooled URL + direct URL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fayreds"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/fayreds"

# ---- Site & admin (Hendy) ----
SITE_URL="http://localhost:3000"
ADMIN_PASSWORD="change-me"
AUTH_SECRET="at-least-32-random-characters-here"

# ---- Pricing ----
CONSULTATION_PRICE_USD=100
CONSULTATION_PRICE_KES=13000

# ---- SMS: Africa's Talking (Mike) ---- leave empty = demo mode (messages are logged)
AT_USERNAME=""          # "sandbox" for testing
AT_API_KEY=""
AT_SENDER_ID=""         # optional approved sender name, e.g. FAYREDS
SMS_INTERNATIONAL=false # true = also SMS non-Kenyan numbers (costs more)

# ---- Email: SMTP (Mike) ---- Gmail: smtp.gmail.com / 465 / fayredstravel@gmail.com / App password
SMTP_HOST=""
SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# ---- Faith's alerts (Mike) ----
FAITH_ALERT_PHONE="+254701484995"
CALLMEBOT_API_KEY=""    # optional WhatsApp alerts via callmebot.com

# ---- M-Pesa Daraja (Mike) ---- empty = demo mode
MPESA_ENV="sandbox"     # sandbox | production
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE="174379"
MPESA_PASSKEY=""
MPESA_TRANSACTION_TYPE="CustomerPayBillOnline"  # CustomerBuyGoodsOnline for a Till
MPESA_PARTY_B=""        # Till number (Buy Goods only); defaults to shortcode
MPESA_CALLBACK_SECRET="random-string"

# ---- Stripe (Mike) ---- empty = demo mode
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
