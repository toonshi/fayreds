generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum EnquiryType {
  MARKETING
  CONSULTATION
  PARTNERSHIP
  RESERVATION
}

enum EnquiryStatus {
  NEW
  AWAITING_PAYMENT
  PAID
  IN_PROGRESS
  COMPLETED
  DECLINED
}

enum PaymentProvider {
  MPESA
  STRIPE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

model Enquiry {
  id        String        @id @default(cuid())
  reference String        @unique
  type      EnquiryType
  status    EnquiryStatus @default(NEW)
  name      String
  email     String
  phone     String
  country   String
  /// All other answers from the form, stored as label -> value
  details   Json
  notes     String?       /// Faith's private notes from the admin panel
  tripId    String?
  trip      Trip?         @relation(fields: [tripId], references: [id])
  spots     Int?
  payments  Payment[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([type, createdAt])
}

model Payment {
  id                String          @id @default(cuid())
  enquiryId         String
  enquiry           Enquiry         @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  provider          PaymentProvider
  status            PaymentStatus   @default(PENDING)
  amount            Int             /// whole units: KES for M-Pesa, USD cents for Stripe
  currency          String          /// "KES" or "USD"
  description       String
  mpesaCheckoutId   String?         @unique
  mpesaReceipt      String?
  stripeSessionId   String?         @unique
  failureReason     String?
  paidAt            DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model Trip {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  destination String
  startDate   DateTime
  endDate     DateTime
  summary     String
  highlights  String[]
  includes    String[]
  imageUrl    String?
  priceKes    Int
  priceUsd    Int
  depositKes  Int
  depositUsd  Int
  totalSpots  Int
  published   Boolean   @default(true)
  enquiries   Enquiry[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
